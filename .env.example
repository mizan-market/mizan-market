# Frontend (Vite exposes only VITE_* values to browser; never put service-role here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=  # supported as a fallback for older Supabase projects
VITE_SITE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true
VITE_GOOGLE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=

# Local Node API only. Never use a Supabase service-role key in the frontend.
PORT=8787
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DEMO_PAYMENT_MODE=true
